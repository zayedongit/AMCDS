# ============================================================
# AMCDS Environment Configuration
# Copy this file to .env and adjust values as needed
# ============================================================

# --- Simulation ---
SIM_SEED=42
SIM_TICK_INTERVAL_MS=100
SIM_NUM_USERS=100
SIM_NUM_HOSTS=100
SIM_NUM_SERVICES=10
SIM_NUM_SUBNETS=5
SIM_SCENARIO=baseline_medium

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HEAP_OPTS=-Xmx768m -Xms512m

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=amcds
POSTGRES_USER=amcds
POSTGRES_PASSWORD=amcds_secure_2024

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Neo4j ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_AUTH=neo4j/amcds_graph_2024

# --- Ray ---
RAY_HEAD_ADDRESS=127.0.0.1:6379
RAY_DASHBOARD_PORT=8265
RAY_OBJECT_STORE_MEMORY=536870912

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=2

# --- Dashboard Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/events

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
